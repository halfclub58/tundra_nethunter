# KernelSU Objects
kernelsu-y := ksu.o \
              allowlist.o app_profile.o apk_sign.o \
              sucompat.o syscall_hook_manager.o \
              throne_tracker.o pkg_observer.o \
              setuid_hook.o lsm_hooks.o \
              kernel_compat.o kernel_umount.o \
              supercalls.o su_mount_ns.o \
              feature.o ksud.o seccomp_cache.o \
              file_wrapper.o util.o extras.o \
              selinux/selinux.o selinux/sepolicy.o selinux/rules.o

obj-$(CONFIG_KSU) += kernelsu.o

# Stealth & Customization
KSU_MODULE_NAME ?= kernelsu
ccflags-y += -DKSU_MODULE_NAME=\"$(KSU_MODULE_NAME)\"

# Include paths
ccflags-y += \
    -I$(srctree)/security/selinux \
    -I$(srctree)/security/selinux/include \
    -I$(objtree)/security/selinux \
    -include $(srctree)/include/uapi/asm-generic/errno.h

# Versioning
KSU_VERSION ?= 32967
KSU_VERSION_TAG ?= v3.0.1

ccflags-y += \
    -DKSU_VERSION=$(KSU_VERSION) \
    -DKSU_VERSION_TAG=\"$(KSU_VERSION_TAG)\"

# Info version/tag
_ksu_v := $(shell echo "-- KernelSU version: $(KSU_VERSION)" >&2)
_ksu_t := $(shell echo "-- KernelSU tag: $(KSU_VERSION_TAG)" >&2)

# Integrity & Security
KSU_NEXT_MANAGER_SIZE ?= 0x3e6
KSU_NEXT_MANAGER_HASH ?= 79e590113c4c4c0c222978e413a5faa801666957b1212a328e46c00c69821bf7

ccflags-y += \
    -DKSU_NEXT_MANAGER_SIZE=$(KSU_NEXT_MANAGER_SIZE) \
    -DKSU_NEXT_MANAGER_HASH=\"$(KSU_NEXT_MANAGER_HASH)\" \
    -DEXPECTED_MANAGER_SIZE=$(KSU_NEXT_MANAGER_SIZE) \
    -DEXPECTED_MANAGER_HASH=\"$(KSU_NEXT_MANAGER_HASH)\"

ifdef KSU_MANAGER_PACKAGE
ccflags-y += -DKSU_MANAGER_PACKAGE=\"$(KSU_MANAGER_PACKAGE)\"
_ksu_p := $(shell echo "-- KernelSU Manager package: $(KSU_MANAGER_PACKAGE)" >&2)
endif

# Performance Tuning
ccflags-y += -O3 -pipe -ftree-vectorize -fomit-frame-pointer -DNDEBUG -UDEBUG

# Hook Modes
ifeq ($(CONFIG_KSU_KPROBES_HOOK),y)
_ksu_h := $(shell echo "-- Hook mode: Kprobes" >&2)
ccflags-y += -DKSU_KPROBES_HOOK
endif

ifeq ($(CONFIG_KSU_MANUAL_HOOK),y)
_ksu_h := $(shell echo "-- Hook mode: Manual" >&2)
ccflags-y += -DKSU_MANUAL_HOOK
endif

ifeq ($(CONFIG_KSU_KPROBES_HOOK)$(CONFIG_KSU_MANUAL_HOOK),)
$(error KernelSU: No hook mode selected!)
endif

# Kernel Compatibility / Auto-detect
define ksu_check
ccflags-y += $$(shell grep -qE $(1) $(2) 2>/dev/null && echo "-D$(3)")
endef

# SELinux Fix
$(eval $(call ksu_check,"current_sid",$(srctree)/security/selinux/include/objsec.h,KSU_COMPAT_HAS_CURRENT_SID))
$(eval $(call ksu_check,"selinux_state",$(srctree)/security/selinux/include/security.h,KSU_COMPAT_USE_SELINUX_STATE))

# Optional backports
$(eval $(call ksu_check,"strncpy_from_user_nofault",$(srctree)/include/linux/uaccess.h,KSU_OPTIONAL_STRNCPY))
$(eval $(call ksu_check,"ssize_t[[:space:]]+kernel_read",$(srctree)/fs/read_write.c,KSU_OPTIONAL_KERNEL_READ))
$(eval $(call ksu_check,"ssize_t[[:space:]]+kernel_write.*const[[:space:]]+void",$(srctree)/fs/read_write.c,KSU_OPTIONAL_KERNEL_WRITE))
$(eval $(call ksu_check,"int[[:space:]]+path_mount",$(srctree)/fs/namespace.c,KSU_HAS_PATH_MOUNT))
$(eval $(call ksu_check,"int[[:space:]]+path_umount",$(srctree)/fs/namespace.c,KSU_HAS_PATH_UMOUNT))

# Seccomp
ifneq ($(shell grep -wq put_seccomp_filter $(srctree)/kernel/seccomp.c $(srctree)/include/linux/seccomp.h 2>/dev/null && echo 1),1)
$(eval $(call ksu_check,"seccomp_filter_release","$(srctree)/kernel/seccomp.c $(srctree)/include/linux/seccomp.h",KSU_OPTIONAL_SECCOMP_FILTER_RELEASE))
endif

# Security & Samsung
$(eval $(call ksu_check,"security_inode_init_security_anon",$(srctree)/include/linux/security.h,KSU_COMPAT_HAS_INIT_SEC_ANON))
$(eval $(call ksu_check,"CONFIG_KDP_CRED",$(srctree)/kernel/cred.c,SAMSUNG_UH_DRIVER_EXIST))
$(eval $(call ksu_check,"SEC_SELINUX_PORTING_COMMON",$(srctree)/security/selinux/avc.c,SAMSUNG_SELINUX_PORTING))

# Warning control
ccflags-y += \
    -Wno-strict-prototypes -Wno-int-conversion -Wno-missing-prototypes \
    -Wno-declaration-after-statement -Wno-unused-function -Wno-unused-variable \
    -Wno-unused-result -Wno-format-security

